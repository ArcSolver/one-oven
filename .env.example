# Optional local configuration; no credentials are needed for stage 1.
PORT=3000
DB_PATH=data/one-oven.sqlite

# S2: select exactly one provider. Model IDs here are placeholders, never defaults.
AGENT_MODEL=scripted:weekday-3
# AGENT_MODEL=openai:<model-id-from-v1-models>
# AGENT_MODEL=anthropic:<model-id>
# AGENT_MODEL=bedrock:<model-or-inference-profile-id>
OPENAI_BASE_URL=http://127.0.0.1:10100/v1
# Loopback endpoints without authentication automatically use a dummy key.
# OPENAI_API_KEY=<your-key>
# ANTHROPIC_API_KEY=<your-key>
AWS_REGION=us-east-1
AGENT_TEMPERATURE=0
AGENT_MAX_TOKENS=2048
MCP_URL=http://127.0.0.1:3000/mcp
GATEWAY_PORT=3001
AGENT_DEVICE=dot
KITCHEN_TIMEZONE=America/Chicago
HOST_AUTO_TIMERS=0
# Opt-in only: set BOTH in the MCP server and chat/gateway environments.
ENABLE_DEV_CLOCK=0
# SIM_CLOCK_START=2026-10-15T17:05:00-05:00

# S3: local voice; no paid API or AWS call is enabled by these selectors.
AGENT_VOICE_MODE=0
VOICE_STT=whisper
VOICE_TTS=system
WHISPER_SERVER_URL=http://127.0.0.1:18080
# Alternative per-clip CLI: omit WHISPER_SERVER_URL and set absolute paths:
# WHISPER_BIN=<absolute-path-to-whisper-cli>
# WHISPER_MODEL=<absolute-path-to-ggml-base.en.bin>
WHISPER_THREADS=4
# Linux default en-gb; macOS default Samantha (omit this override on macOS).
# SYSTEM_TTS_VOICE=en-gb
# Explicit test doubles only: VOICE_STT=fixture, VOICE_TTS=silent
